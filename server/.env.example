PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Dashboard → Account & Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret

# Dashboard → Webhooks → Add webhook (any secret you choose)
RAZORPAY_WEBHOOK_SECRET=change_me

# PostgreSQL. Create the database once (CREATE DATABASE saas;) — tables are created on startup.
DATABASE_URL=postgres://postgres:your_password@localhost:5432/saas

# Any long random string. The Admin tab asks for it before you can edit plans and features.
ADMIN_TOKEN=change_me_too
